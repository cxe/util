#!/usr/bin/env bash

declare -F json >/dev/null || {
    declare -rgx JSON_MIMETYPE="application/json"
    declare -rgx JSON_CONFIG_FILEEXT=(.json .jsonld .jsonc .json5 .ndjson .jsonl .har)
    declare -rgx JSON_CONFIG_COMMENTS="${JSON_CONFIG_COMMENTS:-}"

    json() {
        local w="$*"
        case "$w" in
            null|false|true) return 0;;
            *) return 1;;
        esac
    }

    [ "$0" == "${BASH_SOURCE[0]}" ] && json "$@"
}
