#!/usr/bin/env bash
source "${BASH_SOURCE%/*}/util"

declare -F node >/dev/null || {
    export NODE_BIN="${NODE_BIN:-$( which node 2>/dev/null )}"
    export NODE_VERSION="${NODE_VERSION:-}" # todo
    export NODE_ENV="${NODE_ENV:-development}"

    if [[ -z "$NODE_BIN" ]]; then
        echo "[ERROR] Node.js not found in PATH" >&2
        return 127 2>/dev/null || exit 127
    fi

    export NODE_VERSION="${NODE_VERSION:-$("$NODE_BIN" -v 2>/dev/null || echo unknown)}"

    node() {
        "$NODE_BIN" "$@"
    }

    [ "$0" == "${BASH_SOURCE[0]}" ] && node "$@"
}
